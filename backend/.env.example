# token-sentry backend configuration
# Copy to backend/.env and fill in the keys you have.
# Every key is OPTIONAL — the app degrades gracefully:
# without keys it uses CoinGecko, DexScreener, and GoPlus free tiers.

# CoinMarketCap — trending/newest/gainers lists (free tier: 333 calls/day)
CMC_API_KEY=

# Etherscan — contract verification, creation date
ETHERSCAN_API_KEY=

# Alchemy — supplementary on-chain data
ALCHEMY_API_KEY=

# GitHub — development-activity metrics (higher rate limits with a token)
GITHUB_TOKEN=

# Anthropic — AI summaries on /health/comprehensive?include_llm=true
ANTHROPIC_API_KEY=

# Comma-separated origins allowed by CORS
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LOG_LEVEL=INFO
